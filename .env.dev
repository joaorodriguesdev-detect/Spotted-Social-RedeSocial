# Perfil de desenvolvimento (carregado quando SPOTTED_ENV=dev)
SECRET_KEY=dev-only-change-me
DATABASE_URL=sqlite:///spotted-social.db
APP_AUTO_RELOAD=true
FLASK_DEBUG=true
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

ADMIN_SEED_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

UPLOAD_FOLDER=static/uploads
PUBLIC_FOLDER=static/public
MAX_CONTENT_LENGTH=31457280

FEED_PAGE_SIZE=8
DIRECT_ENABLED=true

SOCKETIO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000
SOCKETIO_ALLOW_UPGRADES=true
SOCKETIO_ASYNC_MODE=threading

SPOTTED_ERROR_LOG=instance/error.log

