# Perfil de producao (carregado quando SPOTTED_ENV=prod)
SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///spotted.db
APP_AUTO_RELOAD=false
FLASK_DEBUG=false
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Use apenas para bootstrap inicial. Depois mantenha false.
ADMIN_SEED_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

UPLOAD_FOLDER=static/uploads
PUBLIC_FOLDER=static/public
MAX_CONTENT_LENGTH=31457280

FEED_PAGE_SIZE=8
DIRECT_ENABLED=true

# Restrinja para seus dominios reais
SOCKETIO_CORS_ALLOWED_ORIGINS=https://seu-dominio.com
SOCKETIO_ALLOW_UPGRADES=true
SOCKETIO_ASYNC_MODE=threading

SPOTTED_ERROR_LOG=instance/error.log

