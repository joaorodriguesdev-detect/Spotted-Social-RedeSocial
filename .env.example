# Flask
SPOTTED_ENV=dev
SECRET_KEY=change-me
DATABASE_URL=sqlite:///spotted.db
SESSION_EXPIRE_DAYS=7
APP_AUTO_RELOAD=true
FLASK_DEBUG=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Admin seed (disabled by default for safety)
ADMIN_SEED_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Upload/static
UPLOAD_FOLDER=static/uploads
PUBLIC_FOLDER=static/public
MAX_CONTENT_LENGTH=31457280

# Feed
FEED_PAGE_SIZE=8

# Direct
DIRECT_ENABLED=true

# Socket.IO
SOCKETIO_CORS_ALLOWED_ORIGINS=https://seu-dominio.com
SOCKETIO_ALLOW_UPGRADES=true
SOCKETIO_ASYNC_MODE=threading

# Logging
SPOTTED_ERROR_LOG=instance/error.log

